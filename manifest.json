{
  "manifest_version": 3,
  "name": "EWU-Toolkit",
  "version": "1.5.1",
  "description": "Complete student utility suite for EWU Portal: visual & mobile routine, Google Calendar sync, course basket & clash sandbox, What-If CGPA planner, advising faculty revealer, dark mode, and captcha solver.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "EWU-Toolkit (Open Source on GitHub)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://portal.ewubd.edu/*",
    "*://faportal.ewubd.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://portal.ewubd.edu/*",
        "*://faportal.ewubd.edu/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}