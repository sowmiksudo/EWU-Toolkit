{
  "manifest_version": 3,
  "name": "EWU-Toolkit",
  "version": "1.0.0",
  "description": "Essential student utility toolkit for East West University portal. Unhides faculty initial, name, email & more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "EWU-Toolkit"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://portal.ewubd.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://portal.ewubd.edu/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}